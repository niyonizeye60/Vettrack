# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# playwright e2e
/test-results/
/playwright-report/
/blob-report/

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user config
SUPERADMIN_README.md
SUPERADMIN_SETUP.md

# scripts
/scripts/*
!/scripts/fix-manifest.cjs
!/scripts/mark-dynamic.mjs
!/scripts/generate-rwanda-coordinates.mjs
!/scripts/sync-rwanda-data.mjs
!/scripts/verify-rwanda-geo.mjs

# calendar feature (not ready to ship)
/app/(veterinary)/veterinary/calendar/

# Rwanda geo source data (large JSON, re-downloadable from GADM)
scripts/data/gadm41_RWA_3.json

# listing photos uploaded in local development (production uses Vercel Blob)
/public/listings/

# consultation documents uploaded in local development (production uses Vercel Blob)
/.local-uploads/


# local tunnel logs
.tunnel*.log
